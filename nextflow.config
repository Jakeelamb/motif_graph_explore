// Global default params
params {
    input = "accensions.txt"
    outdir = "./results"
    publish_dir_mode = "copy"
    temp_dir = "./temp"    // Directory for temporary files
    skip_softmasking = true  // Skip softmasking step if set to true
    
    // SLURM cluster parameters - all optional
    slurm_account = "null"  // Optional SLURM account
    slurm_partition = "day-long-cpu"  // Default partition (if not specified by process)
    slurm_qos = "null"        // Default QOS (if not specified by process)
    
    // Process-specific partition settings
    fetch_genome_partition = "short-cpu"
    index_genome_partition = "day-long-cpu"
    softmask_genome_partition = "day-long-cpu"
    windows_partition = "short-cpu"
    streme_partition = "week-long-highmem"
    trf_partition = "week-long-highmem"
    append_db_partition = "short-cpu"
    clean_temp_partition = "short-cpu"
    
    // Process-specific QOS settings (with null defaults)
    fetch_genome_qos = null
    index_genome_qos = null
    softmask_genome_qos = null
    windows_qos = null
    streme_qos = null
    trf_qos = null
    append_db_qos = null
    clean_temp_qos = null
    
    // Conda settings - use existing environment
    conda_env_path = "/nfs/home/jlamb/bin/miniconda3/envs/motif"
}

// Default process configurations - applied unless overridden by profiles or withName
process {
    // Use the existing conda environment instead of creating from environment.yml
    conda = params.conda_env_path
}

profiles {
    standard {
        process.executor = 'local'
        // Set default resource limits for local execution
        process.cpus = 16
        process.memory = '15 GB'
        // Optional: Set a default time limit if needed, e.g., time = '24h'
        process.conda = '/nfs/home/jlamb/bin/miniconda3/envs/motif'
    }
    slurm {
        process.executor = 'slurm'
        // Default SLURM cluster options - can be overridden by process-specific settings
        process.clusterOptions = {
            def options = []

            if (params.slurm_account) {
                options.add("--account=${params.slurm_account}")
            }

            if (params.slurm_partition) {
                options.add("--partition=${params.slurm_partition}")
            }

            if (params.slurm_qos) {
                options.add("--qos=${params.slurm_qos}")
            }

            return options.join(' ')
        }

        // Process-specific resource configurations for SLURM
        withName: fetch_genome {
            cpus = 2
            memory = '4 GB'
            time = '1h'

            clusterOptions = {
                def options = []

                if (params.slurm_account) {
                    options.add("--account=${params.slurm_account}")
                }

                options.add("--partition=${params.fetch_genome_partition}")

                def qos = params.fetch_genome_qos ?: params.slurm_qos
                if (qos) {
                    options.add("--qos=${qos}")
                }

                return options.join(' ')
            }
        }
        
        withName: index_genome {
            cpus = 2
            memory = '8 GB'
            time = '1h'
            
            clusterOptions = { 
                def options = []
                
                if (params.slurm_account) {
                    options.add("--account=${params.slurm_account}")
                }
                
                options.add("--partition=${params.index_genome_partition}")
                
                def qos = params.index_genome_qos ?: params.slurm_qos
                if (qos) {
                    options.add("--qos=${qos}")
                }
                
                return options.join(' ')
            }
        }
        
        withName: softmask_genome {
            cpus = 16
            memory = '32 GB'
            time = '24h'
            
            clusterOptions = { 
                def options = []
                
                if (params.slurm_account) {
                    options.add("--account=${params.slurm_account}")
                }
                
                options.add("--partition=${params.softmask_genome_partition}")
                
                def qos = params.softmask_genome_qos ?: params.slurm_qos
                if (qos) {
                    options.add("--qos=${qos}")
                }
                
                return options.join(' ')
            }
        }
        
        withName: make_extract_windows {
            cpus = 4
            memory = '16 GB'
            time = '2h'
            
            clusterOptions = { 
                def options = []
                
                if (params.slurm_account) {
                    options.add("--account=${params.slurm_account}")
                }
                
                options.add("--partition=${params.windows_partition}")
                
                def qos = params.windows_qos ?: params.slurm_qos
                if (qos) {
                    options.add("--qos=${qos}")
                }
                
                return options.join(' ')
            }
        }
        
        withName: STREME {
            cpus = 24
            memory = '64 GB'
            time = '168h'
            
            clusterOptions = { 
                def options = []
                
                if (params.slurm_account) {
                    options.add("--account=${params.slurm_account}")
                }
                
                options.add("--partition=${params.streme_partition}")
                
                def qos = params.streme_qos ?: params.slurm_qos
                if (qos) {
                    options.add("--qos=${qos}")
                }
                
                return options.join(' ')
            }
        }
        
        withName: TRF {
            cpus = 4
            memory = '32 GB'
            time = '24h'
            
            clusterOptions = { 
                def options = []
                
                if (params.slurm_account) {
                    options.add("--account=${params.slurm_account}")
                }
                
                options.add("--partition=${params.trf_partition}")
                
                def qos = params.trf_qos ?: params.slurm_qos
                if (qos) {
                    options.add("--qos=${qos}")
                }
                
                return options.join(' ')
            }
        }
        
        withName: append_to_db {
            cpus = 2
            memory = '8 GB'
            time = '1h'
            
            clusterOptions = { 
                def options = []
                
                if (params.slurm_account) {
                    options.add("--account=${params.slurm_account}")
                } 
                
                options.add("--partition=${params.append_db_partition}")
                
                def qos = params.append_db_qos ?: params.slurm_qos
                if (qos) {
                    options.add("--qos=${qos}")
                }
                
                return options.join(' ')
            }
        }
        
        withName: clean_temp {
            cpus = 1
            memory = '2 GB'
            time = '1h'
            
            clusterOptions = { 
                def options = []
                
                if (params.slurm_account) {
                    options.add("--account=${params.slurm_account}")
                }
                
                options.add("--partition=${params.clean_temp_partition}")
                
                def qos = params.clean_temp_qos ?: params.slurm_qos
                if (qos) {
                    options.add("--qos=${qos}")
                }
                
                return options.join(' ')
            }
        }
    }
    
    // Special profile for memory-intensive tasks
    highmem {
        process.executor = 'slurm'
        
        withName: STREME {
            cpus = 24
            memory = '128 GB'
            time = '168h'
            
            clusterOptions = {
                def options = []
                
                if (params.slurm_account) {
                    options.add("--account=${params.slurm_account}")
                }
                
                options.add("--partition=week-long-highmem")
                
                return options.join(' ')
            }
        }
        
        withName: softmask_genome {
            cpus = 16
            memory = '128 GB' 
            time = '24h'
            
            clusterOptions = {
                def options = []
                
                if (params.slurm_account) {
                    options.add("--account=${params.slurm_account}")
                }
                
                options.add("--partition=day-long-highmem")
                
                return options.join(' ')
            }
        }
    }
}

// Enable conda
conda {
    enabled = true
    useMamba = false
    // Don't create new environments, use the existing one
    createEnvironments = false
    cacheDir = '/nfs/home/jlamb/bin/miniconda3/envs'
}

// Manifest for pipeline information
manifest {
    name = 'motif_graph_explore'
    author = 'jakeelamb'
    description = 'denovo motif graph generator and assembly index calculator'
    version = '1.0.0'
    nextflowVersion = '>=21.10.0'
}

// Reporting
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
} 
